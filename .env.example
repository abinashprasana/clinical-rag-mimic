# Copy this file to .env and fill in real values. .env is gitignored.
#
# All defaults below match the values the app already used before the
# config/secrets layer existed, so the retrieval-only pipeline runs fine
# with no .env present at all. Leave GEMINI_API_KEY blank for MIMIC-IV-Note
# or any other restricted data: routing context and generated drafts can
# contain derived clinical facts. External Gemini features are for fabricated
# or otherwise unrestricted data only.

# --- Agent orchestration (Google Gemini free tier — no credit card required) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Send the local model's generated draft answer (which can contain derived
# clinical facts) to Gemini for a structural quality check. Off by default --
# use only with fabricated or otherwise unrestricted data. It is advisory
# only (never blocks or changes the response) and isn't rendered in the UI
# today, so it's a pure extra network round-trip. Set to true to enable it.
ENABLE_EXTERNAL_REFLECTION=false

# Caps how long any single Gemini call (routing, clarification, structural
# check) can take before the app falls back to its local heuristics. Must
# stay >= 10 -- Gemini's API rejects a shorter deadline outright.
GEMINI_TIMEOUT_SECONDS=12

# Hard cap on agent steps per turn, prevents infinite reflect/regenerate loops.
MAX_AGENT_STEPS=6

# --- Tools ---
OPENFDA_TIMEOUT_SECONDS=8

# --- Flask ---
# Required for signed session cookies (session-level agent memory). Generate
# a real random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-generate-a-random-value
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# --- Data / chunking / retrieval (rarely need to change these) ---
SAMPLE_SIZE=5000
RANDOM_SEED=42
MAX_CHUNK_WORDS=180
CHUNK_OVERLAP=40
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
DEFAULT_TOP_K=5
OUTPUT_DIR=outputs/

# --- Generation (local model, always stays on-device) ---
LOCAL_GENERATOR_MODEL=google/flan-t5-base
MAX_NEW_TOKENS=200
